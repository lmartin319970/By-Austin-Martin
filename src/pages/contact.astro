---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <section class="container page-intro">
    <div class="eyebrow">Get in touch</div>
    <h1>Let's talk writing.</h1>
    <p class="lede">
      For editorial inquiries, freelance opportunities, feedback,
      or a note about something you've read.
    </p>
  </section>

  <section class="container" style="padding-bottom:130px">
    <h2 style="font-size:1.5rem">Email</h2>
    <p>
      Response will be in timely manner. Thanks for reaching out.
    </p>
    <a class="button" href="mailto:byaustinmartin@gmail.com">
      byaustinmartin@gmail.com ↗
    </a>
  </section>
</Base>
