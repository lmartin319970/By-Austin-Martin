---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = entries.filter((x) => x.data.featured).slice(0, 3);
const recent = featured.length ? featured : entries.slice(0, 3);
---

<Base>
  <section class="hero container">
    <div class="eyebrow">Independent writing / Austin Martin</div>
    <h1>Explorations in <em>analysis and commentary.</em></h1>
    <p class="lede">
      A refinement of ideas through essays,
      criticism, stories, and other writing.
    </p>
    <div class="actions">
      <a class="button" href="/writing/">Explore the writing ↗</a>
      <a class="button secondary" href="/portfolio/">Portfolio</a>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-head">
        <h2>From the journal</h2>
        <a href="/writing/">View all writing ↗</a>
      </div>

      <div class="article-grid">
        {recent.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:850px">
      <div class="eyebrow">A note from the writer</div>
      <h2>
        Not one subject. A place to document, refine, and justify
        opinions of both vague and tangible.
      </h2>
      <p class="lede">
        Film, sport, culture, fiction. This site is both an evolving
        journal and a collection of work I'm proud to share.
      </p>
      <a class="text-link" href="/about/">A little more about me ↗</a>
    </div>
  </section>
</Base>
