---
import { genres, type Section } from '../lib/genres';
interface Props { section: Section; counts: Record<string, number> }
const { section, counts } = Astro.props;
const visible = genres.filter(genre => section === 'writing' || counts[genre.slug]);
---
<div class="article-grid">
  {visible.map(genre => <a class="article-card" href={`/${section}/${genre.slug}/`}>
    <div class="meta">{section === 'writing' ? 'Writing' : 'Portfolio'}</div>
    <h2>{genre.name}</h2>
    <p>{genre.description}</p>
    <div class="bottom">{counts[genre.slug] || 0} {counts[genre.slug] === 1 ? 'piece' : 'pieces'} <span aria-hidden="true">↗</span></div>
  </a>)}
</div>
{!visible.length && <p class="empty">Portfolio pieces will appear here when added.</p>}
