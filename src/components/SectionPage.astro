---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import GenreDirectory from './GenreDirectory.astro';
import { genreSlug, type Section } from '../lib/genres';
import { getSectionEntries } from '../lib/writing';
interface Props { section: Section }
const { section } = Astro.props;
const portfolio = section === 'portfolio';
const title = portfolio ? 'Portfolio' : 'Writing';
const entries = await getSectionEntries(section);
const counts: Record<string, number> = {};
for (const entry of entries) {
  const slug = genreSlug(entry.data.category);
  counts[slug] = (counts[slug] || 0) + 1;
}
---
<Base title={title} description={`${portfolio ? 'Writing samples and publication credits' : 'All website writing'} by Austin Martin, organized by genre.`}>
  <section class="container page-intro">
    <h1>{title}</h1>
    <p class="lede">{portfolio ? 'Writing samples and publication credits, organized by genre. Explore a subject to find relevant work.' : 'An ongoing collection of essays, observations, criticism, and stories. Explore the writing by genre.'}</p>
    {portfolio && <a class="text-link" href="/writing/">Browse all writing</a>}
  </section>
  <section class="container" style="padding-bottom:90px" aria-label={`${title} genres`}>
    <GenreDirectory section={section} counts={counts} />
  </section>
  {!portfolio && <section class="section tint"><div class="container">
    <h2>Latest Writing</h2>
    <div class="article-grid">{entries.slice(0, 6).map(entry => <ArticleCard entry={entry} />)}</div>
    {!entries.length && <p class="empty">Writing will appear here when published.</p>}
  </div></section>}
</Base>
